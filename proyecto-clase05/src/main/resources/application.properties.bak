spring.application.name=proyecto-clase05

# --- Base de datos H2 en memoria -------------------------------------------
# La base vive en la RAM del proceso: no se instala nada y al cerrar la
# aplicacion los datos se pierden.
spring.datasource.url=jdbc:h2:mem:clase05;DB_CLOSE_DELAY=-1
spring.datasource.driver-class-name=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=

# --- Consola web de H2 -----------------------------------------------------
# http://localhost:8080/h2-console para mirar las tablas con SQL.
spring.h2.console.enabled=true
spring.h2.console.path=/h2-console

# --- JPA / Hibernate -------------------------------------------------------
# create-drop: Hibernate crea las tablas al arrancar mirando las clases
# anotadas con @Entity, y las borra al apagar.
spring.jpa.hibernate.ddl-auto=create-drop

# Muestra en la consola el SQL que se ejecuta.
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Respuestas JSON indentadas, para que se lean mas facil.
spring.jackson.serialization.indent-output=true
